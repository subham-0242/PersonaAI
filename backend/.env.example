# ==============================================================================
# PersonaPanel AI - Backend Environment Configuration (SIH26044)
# ==============================================================================

# Google Gemini API Key (for Ingestion, Contradiction Engine & Post-Interview Scoring)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (for Whisper-large-v3 Audio STT and LLaMA 3.3 70B Conversational Turns)
GROQ_API_KEY=your_groq_api_key_here

# Redis URL for Real-Time Session State & Claims Storage
REDIS_URL=redis://localhost:6379/0

# Server Host & Port
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
